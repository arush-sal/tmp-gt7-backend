# Keep the build context small and reproducible: only Go source + embedded migrations are needed to
# build the binaries. Everything below is either huge, host-specific, or irrelevant to `go build`.
.git
.githooks
.worktrees
bin
dist
# Installed inside the image by the web stage (npm ci); never ship the host's copy.
web/node_modules
*.log
*.md
# Test fixtures (golden CSVs, pcap-derived data) — not referenced by any //go:embed, so not needed to
# compile cmd/rtps or cmd/collector.
**/testdata
# Compose + Docker files themselves don't belong inside the image.
docker-compose*.yml
Dockerfile*
.dockerignore
